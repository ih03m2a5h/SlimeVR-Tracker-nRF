#include "../socs/nrf54l15_cpuapp.overlay"

/ {
	/*
	 * XIAO nRF54L15 (cpuapp) application overlay
	 *
	 * This overlay intentionally relies on the board's *standard* pin mapping
	 * (Zephyr's xiao_nrf54l15 board DTS) for the buses:
	 * - I2C: D4/D5
	 * - SPI: D8/D9/D10
	 *
	 * Only the required nodes for SlimeVR-Tracker-nRF are added here.
	 */

	battery-divider {
		compatible = "voltage-divider";
		status = "okay";
		/* Internal VDD measurement (no external pin). */
		io-channels = <&adc 12>; /* Measure VDDHDIV5 */
		output-ohms = <1>;
		full-ohms = <2>;
	};

	zephyr,user {
		/*
		 * Optional wiring-specific pins can be added here.
		 * Examples:
		 *  - int0-gpios = <&gpio? ? GPIO_ACTIVE_HIGH>;
		 *  - led-gpios  = <&gpio? ? (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		 */
	};
};

/* I2C IMU + magnetometer: use the board's default I2C pinctrl (XIAO standard pins). */
&i2c22 {
	status = "okay";
	zephyr,concat-buf-size = <1023>;
	zephyr,flash-buf-max-size = <1023>;
	clock-frequency = <I2C_BITRATE_FAST>;

	imu: imu@0 {
		compatible = "i2c-device";
		label = "imu";
		/* reg = <0> enables address auto-scan */
		reg = <0>;
	};

	mag: mag@0 {
		compatible = "i2c-device";
		label = "mag";
		reg = <0>;
	};
};

/* SPI IMU (+ optional SPI magnetometer): use the board's default SPI pinctrl (XIAO standard pins). */
&spi00 {
	status = "okay";

	imu_spi: imu_spi@0 {
		compatible = "vnd,spi-device";
		spi-max-frequency = <DT_FREQ_M(24)>;
		label = "imu-spi";
		reg = <0>;
	};

	mag_spi: mag_spi@1 {
		compatible = "vnd,spi-device";
		spi-max-frequency = <DT_FREQ_M(24)>;
		label = "mag-spi";
		reg = <1>;
	};
};

/*
 * Note: This board DTS does not define an on-board IMU node label.
 * If a board variant adds an IMU, disable it in that variant's overlay.
 */