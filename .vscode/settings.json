{
    "files.associations": {
        "*.h": "c"
    },
    "nrf-connect.toolchain.path": "${nrf-connect.toolchain:2.9.0}",
    "nrf-connect.topdir": "${nrf-connect.sdk:2.9.0}",
    "chat.tools.terminal.autoApprove": {
        "/^bash build\\.sh && tail -5 build_out\\.log$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}